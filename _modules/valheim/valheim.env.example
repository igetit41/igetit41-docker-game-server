# Copy to valheim.env in this directory (gitignored).
# Terraform delivers GAME_ENV_B64 from valheim.env; SERVER_PASS is also upserted from
# instance metadata SERVER_PASSWORD on boot (same pattern as Smalland PASSWORD).

SERVER_NAME=RtDMMO
WORLD_NAME=RtDMMO
SERVER_PASS=changeme
# SERVER_PASS must be at least 5 characters or the dedicated server will refuse to start.

SERVER_PUBLIC=true
# Steam Deck / Steam PC: keep CROSSPLAY=false (PlayFab crossplay breaks BepInEx).
CROSSPLAY=false

# Thunderstore modpack: https://thunderstore.io/c/valheim/p/Soloredis/RtDMMO/
# Clients (PC + Steam Deck) must install the same pack via r2modman or Gale.
BEPINEX=true
VALHEIM_PLUS=false
THUNDERSTORE_PACK=Soloredis-RtDMMO
THUNDERSTORE_PACK_VERSION=3.1.41

TZ=America/Los_Angeles

# Idle detection uses status.json on container port 80 (bound to host 127.0.0.1 only).
STATUS_HTTP=true
STATUS_HTTP_PORT=80

# Optional supervisor UI — not published on the host in compose.yaml
SUPERVISOR_HTTP=false
